# Modo atual para validação sem banco. A migração comercial está documentada em docs/MIGRACAO_SUPABASE.md.
NEXT_PUBLIC_DATA_MODE=demo

# Supabase - preencher ao iniciar a fase de conexão com PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL

# Nunca exponha esta chave no navegador. Usar apenas em Route Handlers/Server Actions.
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
